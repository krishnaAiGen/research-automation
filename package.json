{
  "name": "research-automation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "import": "tsx scripts/import.ts",
    "reset": "tsx scripts/reset.ts",
    "db:rebuild": "rm -f data/app.db data/app.db-wal data/app.db-shm && tsx scripts/import.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "next": "15.5.26",
    "nodemailer": "10.0.12",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
