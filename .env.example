# Copy to .env.local and fill in.

# ---- OpenRouter (generates the research queries per paper) ----
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---- Gmail SMTP (delivery) ----
# A Google *App Password*, not your normal password. Requires 2FA:
#   https://myaccount.google.com/apppasswords
# Without these, live sends are blocked and only dry runs work.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=

# ---- Import source ----
# Root of the openreview-scrapper checkout; `npm run import` reads
# <SCRAPER_ROOT>/downloads/papers.json and
# <SCRAPER_ROOT>/email_generator/sent_log.jsonl
SCRAPER_ROOT=/Users/krishnayadav/Documents/test_projects/openreview-scrapper

# ---- Storage ----
# Defaults to ./data/app.db
# DATABASE_PATH=
